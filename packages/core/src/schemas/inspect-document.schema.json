{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.aep.foundation/schemas/inspect-document.schema.json",
  "title": "AEP Inspect Document",
  "type": "object",
  "required": ["aep_version", "bindings", "commands", "core", "http", "identity", "service"],
  "additionalProperties": true,
  "properties": {
    "aep_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "authentication": {
      "type": "object",
      "required": ["methods"],
      "additionalProperties": false,
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "required": ["supported"],
      "additionalProperties": true,
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "http"
          },
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "preferred": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "required": ["supported"],
      "additionalProperties": true,
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "inspect"
          },
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "grant_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "grant_types_config": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "supports_per_credential_revoke": {
                "type": "string",
                "enum": ["false", "true"]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["grant_types"],
            "properties": {
              "grant_types": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "supported": {
                "not": {
                  "contains": { "enum": ["grant", "revoke"] }
                }
              }
            }
          }
        }
      ]
    },
    "core": {
      "type": "object",
      "required": ["signing_algorithms"],
      "additionalProperties": true,
      "properties": {
        "signing_algorithms": {
          "type": "array",
          "minItems": 1,
          "allOf": [{ "contains": { "const": "EdDSA" } }, { "contains": { "const": "ES256" } }],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoint_base": {
          "type": "string",
          "pattern": "^/"
        },
        "openapi": {
          "type": "object",
          "required": ["url", "path_matching"],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "format": "uri-reference"
            },
            "path_matching": {
              "type": "object",
              "required": ["trailing_slash"],
              "additionalProperties": false,
              "properties": {
                "trailing_slash": {
                  "type": "string",
                  "enum": ["strict", "equivalent"]
                }
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "required": ["methods"],
      "additionalProperties": true,
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?::[a-z0-9]+)*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["did"],
      "additionalProperties": true,
      "properties": {
        "did": {
          "type": "string",
          "pattern": "^did:"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "commands": {
            "properties": {
              "supported": {
                "contains": { "enum": ["enroll", "grant", "revoke", "status"] }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "methods": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
