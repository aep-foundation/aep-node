{
  "id": "negotiation-compatibility",
  "title": "Claim negotiation compatibility behavior",
  "description": "Unknown and omitted claims follow the required, preferred, optional, and submitted-claim rules.",
  "drafts": ["draft-kavian-agent-enrollment-protocol-02", "draft-kavian-aep-claims-00"],
  "category": "claims",
  "applies_to": ["agent", "service"],
  "profile": "claims",
  "input": {
    "inspect": {
      "required": ["contact.email"],
      "preferred": ["example.future.preferred"],
      "optional": ["example.future.optional"]
    },
    "submitted": {
      "contact.email": "owner@example.com",
      "example.unadvertised": "extra"
    }
  },
  "expected": {
    "enrollment_requirement_satisfied": true,
    "omitted_preferred_allowed": true,
    "unknown_optional_action": "ignore",
    "unknown_preferred_action": "ignore",
    "unknown_submitted_default_action": "ignore"
  }
