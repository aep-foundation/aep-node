{
  "name": "aep-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Public Node.js SDK packages for the Agent Enrollment Protocol.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aep-foundation/aep-node.git"
  },
  "bugs": {
    "url": "https://github.com/aep-foundation/aep-node/issues"
  },
  "homepage": "https://github.com/aep-foundation/aep-node#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "update:all": "pnpm update --recursive --depth Infinity && pnpm sync:spec-artifacts",
    "coverage:changed": "node scripts/check-changed-coverage.mjs",
    "test:watch": "turbo run test:watch --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify:pkg": "turbo run typecheck lint test build",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "sync:spec-artifacts": "node scripts/sync-aep-spec-artifacts.mjs --write",
    "check:spec-artifacts": "node scripts/sync-aep-spec-artifacts.mjs --check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typedoc": "typedoc",
    "conformance:agent": "pnpm exec turbo run build --filter=@aep-foundation/agent && node scripts/run-role-conformance.mjs --role agent",
    "conformance:platform": "pnpm exec turbo run build --filter=@aep-foundation/platform && node scripts/run-role-conformance.mjs --role platform",
    "conformance:service": "pnpm exec turbo run build --filter=@aep-foundation/service && node scripts/run-role-conformance.mjs --role service",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm coverage:changed && pnpm typedoc && pnpm build && pnpm smoke:examples",
    "check-exports": "node scripts/check-exports.mjs",
    "check-no-build-artifacts": "node scripts/check-no-build-artifacts.mjs",
    "verify-publish": "node scripts/verify-publish.mjs",
    "check-publish": "pnpm build && pnpm check-exports && pnpm verify-publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check-publish && changeset publish",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsdoc": "^63.3.3",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
